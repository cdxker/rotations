PORT=3010
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key
REDIS_URL=redis://127.0.0.1:6379
# Configure all three values to enable Discord voice bridging. Use the bot
# token from the Discord Developer Portal, never a personal account token.
DISCORD_BOT_TOKEN=
DISCORD_VOICE_DESTINATIONS='[{"code":"55","name":"Zeus Boost Voice","guildId":"1066091826240561272","channelId":"1127096237859024946"}]'
# Generate with: openssl rand -hex 32
VONAGE_WEBSOCKET_SECRET=
# Optional; defaults to 30000 ms.
DISCORD_BRIDGE_IDLE_MS=30000
